{
  "name": "newsworthy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:dev": "turbo build:dev",
    "lint": "turbo lint",
    "dev:dashboard": "turbo dev --filter=@nwai/dashboard",
    "dev:website": "turbo dev --filter=@nwai/website",
    "build:dashboard": "turbo build --filter=@nwai/dashboard",
    "build:website": "turbo build --filter=@nwai/website",
    "dev:oauth": "turbo dev --filter=@nwai/oauth",
    "build:oauth": "turbo build --filter=@nwai/oauth"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "bun@1.2.4",
  "overrides": {
    "@xmldom/xmldom": "^0.8.12",
    "form-data": "^4.0.6",
    "dompurify": "^3.4.6",
    "qs": "^6.15.2"
  },
  "dependencies": {
    "@dayflow/blossom-color-picker-react": "^1.1.0",
    "baseline-browser-mapping": "^2.11.1",
    "caniuse-lite": "^1.0.30001806",
    "mammoth": "^1.12.0",
    "next": "16.2.12",
    "posthog-js": "^1.409.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
